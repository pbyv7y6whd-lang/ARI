# The only things you need to fill in:

# 1. Your Anthropic API key — get it at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 2. A password to protect your app (make up anything you like)
APP_PASSWORD=changeme

# 3. A random secret string (mash your keyboard, 32+ chars)
SESSION_SECRET=change-this-to-something-long-and-random-please

# These are added automatically by Vercel when you click "Add Storage":
# BLOB_READ_WRITE_TOKEN=        (Vercel Blob — auto-filled)
# POSTGRES_URL=                 (Vercel Postgres — auto-filled)
