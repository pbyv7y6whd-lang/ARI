{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/recent/layout,_N_T_/dashboard/recent/page,_N_T_/dashboard/recent"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/recent/__PAGE__",
    "/dashboard/recent",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}