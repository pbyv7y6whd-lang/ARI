{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/stocks/[id]",
      "regex": "^/api/stocks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/stocks/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/stocks/[id]/analyse",
      "regex": "^/api/stocks/([^/]+?)/analyse(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/stocks/(?<nxtPid>[^/]+?)/analyse(?:/)?$"
    },
    {
      "page": "/api/stocks/[id]/documents",
      "regex": "^/api/stocks/([^/]+?)/documents(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/stocks/(?<nxtPid>[^/]+?)/documents(?:/)?$"
    },
    {
      "page": "/dashboard/stocks/[id]",
      "regex": "^/dashboard/stocks/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/stocks/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/api/auth/login",
      "regex": "^/api/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/logout",
      "regex": "^/api/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/logout(?:/)?$"
    },
    {
      "page": "/api/initiate-coverage",
      "regex": "^/api/initiate\\-coverage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/initiate\\-coverage(?:/)?$"
    },
    {
      "page": "/api/initiate-coverage-upload",
      "regex": "^/api/initiate\\-coverage\\-upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/initiate\\-coverage\\-upload(?:/)?$"
    },
    {
      "page": "/api/stocks",
      "regex": "^/api/stocks(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/stocks(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/governance",
      "regex": "^/dashboard/governance(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/governance(?:/)?$"
    },
    {
      "page": "/dashboard/recent",
      "regex": "^/dashboard/recent(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/recent(?:/)?$"
    },
    {
      "page": "/dashboard/risk",
      "regex": "^/dashboard/risk(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/risk(?:/)?$"
    },
    {
      "page": "/dashboard/settings",
      "regex": "^/dashboard/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/settings(?:/)?$"
    },
    {
      "page": "/dashboard/themes",
      "regex": "^/dashboard/themes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/themes(?:/)?$"
    },
    {
      "page": "/dashboard/watchlists",
      "regex": "^/dashboard/watchlists(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/watchlists(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}